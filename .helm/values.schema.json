{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": ["image", "service", "collector", "postgresql"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "Never", "IfNotPresent"]
        },
        "tag": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "required": ["enabled", "type", "port"],
      "properties": {
        "enabled": { "type": "boolean" },
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "collector": {
      "type": "object",
      "required": ["port", "targetChannels", "twitch", "persistence"],
      "properties": {
        "existingSecret": { "type": "string" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetChannels": { "type": "string" },
        "callbackUrl": { "type": "string" },
        "logLevel": { "type": "string" },
        "storagePath": { "type": "string" },
        "twitch": {
          "type": "object",
          "required": ["clientId", "clientSecret"],
          "properties": {
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" }
          }
        },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "existingClaim": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled", "auth", "image", "persistence"],
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "required": ["username", "password", "database"],
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" },
            "database": { "type": "string" }
          }
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "Never", "IfNotPresent"]
            }
          }
        },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        }
      }
    }
  }
}
